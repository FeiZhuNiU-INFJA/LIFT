HERMES_API_KEY=your_api_key
HERMES_ENV_FILE=~/.hermes/.env
MODEL_NAME=custom-ark-cn-beijing-volces-com/doubao-seed-2-0-pro-260215
# Ark API key (baked into Docker image via agent-runtimes/openclaw/build-image.sh)
ARK_API_KEY=your_ark_api_key

DO_TRAJECTORY_JUDGE=false
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-openai-compatible-endpoint
TRAJECTORY_JUDGE_MODEL=gpt-4o-mini

LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# Host dev: localhost; containers use host.docker.internal (src overrides automatically)
LANGFUSE_BASE_URL=http://localhost:3000
# Post-process trace backfill 并发拉 langfuse 的 worker 数（默认 8）。
# langfuse server 顶不住时下调（如 4），数据量小可上调。
# EVAL_BACKFILL_WORKERS=8

# Search API KEY
FIRECRAWL_API_KEY=your_firecrawl_api_key

# TOS personal credentials (preprocess downloads aml-fde-boe/benchmark_mds.zip)
# CN BOE buckets created after 2022-02-24 require personal key pair (StaticCredentials).
TOS_ACCESS_KEY=your_access_key
TOS_SECRET_KEY=your_secret_key
# Optional BOE endpoint override (default: tos-cn-north-boe.byted.org)
# TOS_ENDPOINT=tos-cn-north-boe.byted.org

# Optional: read benchmark_mds.zip from HuggingFace instead of TOS
# Set BENCHMARK_SOURCE=huggingface (or pass --source huggingface to preprocess CLI).
# BENCHMARK_HF_REPO defaults to FeiZhuNiU-INFJA/EALE (the official mirror); override only if forking.
# HF_TOKEN is only required for uploading or for private repos.
BENCHMARK_SOURCE=tos
# BENCHMARK_HF_REPO=FeiZhuNiU-INFJA/EALE
HF_TOKEN=

# Hermes API Server
API_SERVER_ENABLED=true
API_SERVER_KEY=hermes-114514-1919810
