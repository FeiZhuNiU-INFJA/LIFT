# ============================================================================
# Model selection (shared)
# ============================================================================
# provider/model_id. For OpenClaw this must match a provider/model registered
# in agent-runtimes/openclaw/config/models.fragment.json. For Hermes the
# suffix after "/" becomes model.default and provider is forced to "custom"
# in the container config.yaml (see agent-runtimes/hermes).
MODEL_NAME=custom-ark-cn-beijing-volces-com/doubao-seed-2-0-pro-260215

# Max output tokens for a single work/judge chat turn (replaces legacy
# HERMES_MAX_TOKENS). Applies to Hermes runner; default 51200.
MAX_TOKENS=51200

# ============================================================================
# Work LLM (the agent under evaluation)
# ============================================================================
# OpenAI-compatible credentials used by the WORK agent. For Hermes these are
# written into the container config.yaml (base_url / api_key). Renamed from the
# legacy ARK_API_KEY; the work LLM now uses a dedicated key + base_url so it can
# differ from the trajectory judge LLM.
WORK_OPENAI_API_KEY=your_work_api_key
WORK_OPENAI_BASE_URL=https://your-openai-compatible-endpoint

# ============================================================================
# Trajectory judge LLM (optional, only when DO_TRAJECTORY_JUDGE=true)
# ============================================================================
# Separate key + base_url so the trajectory judge can use a different LLM than
# the work agent. The paired (content) judge still shares the work LLM.
DO_TRAJECTORY_JUDGE=false
TRAJECTORY_JUDGE_OPENAI_API_KEY=your_judge_api_key
TRAJECTORY_JUDGE_OPENAI_BASE_URL=https://your-openai-compatible-endpoint
TRAJECTORY_JUDGE_MODEL=gpt-4o-mini

# ============================================================================
# Hermes runtime (agent-runtimes/hermes)
# ============================================================================
# Upstream Hermes base image tag. Default pins to v2026.5.16 to match the
# Hermes version used by the legacy stack. Override to bump/downgrade.
HERMES_BASE_IMAGE_TAG=v2026.5.16
# Set to host when encountering network issue (Hermes Only)
HERMES_NETWORK_MODE=
# Optional: explicit Hermes model id passed to the runner --model. If unset,
# the runner derives it from MODEL_NAME (suffix after "/").
# HERMES_MODEL_NAME=
# Optional: Hermes work LLM base url override. If unset, WORK_OPENAI_BASE_URL is used.
# HERMES_API_URL=

# ============================================================================
# Langfuse (required for traces)
# ============================================================================
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# Host dev: localhost; containers use host.docker.internal (src overrides automatically)
LANGFUSE_BASE_URL=http://localhost:3000
# Post-process trace backfill 并发拉 langfuse 的 worker 数（默认 8）。
# langfuse server 顶不住时下调（如 4），数据量小可上调。
# EVAL_BACKFILL_WORKERS=8

# ============================================================================
# Search API KEY (optional)
# ============================================================================
FIRECRAWL_API_KEY=your_firecrawl_api_key

# ============================================================================
# TOS personal credentials (preprocess downloads aml-fde-boe/benchmark_mds.zip)
# ============================================================================
# CN BOE buckets created after 2022-02-24 require personal key pair (StaticCredentials).
TOS_ACCESS_KEY=your_access_key
TOS_SECRET_KEY=your_secret_key
# Optional BOE endpoint override (default: tos-cn-north-boe.byted.org)
# TOS_ENDPOINT=tos-cn-north-boe.byted.org

# ============================================================================
# Benchmark source (optional)
# ============================================================================
# Optional: read benchmark_mds.zip from HuggingFace instead of TOS
# Set BENCHMARK_SOURCE=huggingface (or pass --source huggingface to preprocess CLI).
# BENCHMARK_HF_REPO defaults to FeiZhuNiU-INFJA/EALE (the official mirror); override only if forking.
# HF_TOKEN is only required for uploading or for private repos.
BENCHMARK_SOURCE=tos
# BENCHMARK_HF_REPO=FeiZhuNiU-INFJA/EALE
HF_TOKEN=

# ============================================================================
# Hermes API Server (Deprecated)
# ============================================================================
API_SERVER_ENABLED=true
API_SERVER_KEY=hermes-114514-1919810
