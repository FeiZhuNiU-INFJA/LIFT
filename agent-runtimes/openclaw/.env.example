# Copy to repo root .env or pass to openclaw-instance.sh / docker run

# Work LLM (OpenAI-compatible) — required for model calls
WORK_OPENAI_API_KEY=your-work-api-key

# Model selection — required at image build time. Must be "custom/model_id"
# (provider prefix is fixed to "custom"). The part after "/" is injected as the
# model.id in config/models.fragment.json; the full string becomes the
# agents.fragment primary / models key.
MODEL_NAME=custom/ep-20260529115331-9zxpm

# Langfuse — read by langfuse-tracer inside the container
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Inside Docker, use host gateway (not 127.0.0.1)
LANGFUSE_BASE_URL=http://host.docker.internal:3000

# Optional overrides
# 是否安装并启用 self-evolving-plugin-pro 进化插件由 build-image.sh 的 --with-evolve 参数控制：
#   bash build-image.sh                → lift-openclaw-base:latest（默认，不带进化插件）
#   bash build-image.sh --with-evolve  → lift-openclaw-with-evolve:latest（带进化插件）
# 显式 override 构建产物 tag（默认根据是否传 --with-evolve 自动推导，见 build-image.sh）
# OPENCLAW_IMAGE=lift-openclaw-with-evolve:latest
# OPENCLAW_GATEWAY_TOKEN=  # auto-generated if unset at container start
