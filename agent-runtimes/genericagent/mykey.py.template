# GenericAgent 配置（LIFT 评测镜像构建期渲染；占位符由 scripts/install-config.sh 注入）。
#
# 上游约定：变量名包含 'oai' / 'claude' / 'mixin' / 'native' 决定使用哪种 Session
# 类。这里使用 OpenAI 兼容协议（火山方舟 Ark）作为 doubao 后端。
#
# 不要在本文件里硬编码 secret —— 模板由 docker build 期 sed 渲染，运行期 mykey.py
# 是产物固件。需要按 run 切 Key 时，使用 LIFT adapter 临时 bind-mount 替换。

native_oai_config = {
    "name": "doubao",
    "apikey": "__WORK_OPENAI_API_KEY__",
    "apibase": "__WORK_OPENAI_BASE_URL__",
    "model": "__MODEL_NAME__",
    "api_mode": "openai-completions",
    "reasoning_effort": "__REASONING_EFFORT__",
    # LIFT 契约:全 runtime 共用 ``MAX_TOKENS`` 环境变量控制单轮输出上限;GA
    # ``BaseSession.__init__`` 读 ``cfg.get('max_tokens')`` 后由 ``llmcore.py``
    # 的 openai-completions / responses 分支透传为 ``max_tokens`` /
    # ``max_completion_tokens`` / ``max_output_tokens`` 请求字段。未在此声明时
    # GA 上游 fallback 到 8192,长产出场景会被截断。
    "max_tokens": __MAX_TOKENS__,
    # GA 历史裁剪触发阈值(字符):``trim_messages_history`` 里 cap = context_win*3。
    # doubao-seed 256k token 窗口,扣除 max_tokens(51200) + system/tool schema 约
    # 10k 余量,prefill 上限 ~= 195k token ~= 330k 字符;取 85000 让 cap = 255000
    # 字符 ~= 150k token prefill,留 45k token 余量避免命中 API context 上限。
    # 上游默认 30000 会让长对话过早裁掉关键 tool_result / 首消息,agent 反复
    # 回读文件 → 单轮 loop 步数暴涨 → 撞 CHAT_EXEC_TIMEOUT_SECONDS。
    "context_win": 85000,
}

langfuse_config = {
    "public_key": "__LANGFUSE_PUBLIC_KEY__",
    "secret_key": "__LANGFUSE_SECRET_KEY__",
    "host": "__LANGFUSE_HOST__",
}

# Firecrawl Cloud API 配置（LIFT 评测容器无浏览器，用 Firecrawl 做联网搜索 / 抓取）。
# apikey 为空时 firecrawl_plugin 直接返回错误，不抛异常，避免污染 LLM tool dispatch。
firecrawl_config = {
    "apikey": "__FIRECRAWL_API_KEY__",
    "apibase": "https://api.firecrawl.dev/v1",
}
